{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateProfileObjectOutput",
  "type": "object",
  "required": ["schemaVersion", "objects"],
  "properties": {
    "schemaVersion": {"const": "candidate_profile_object.v2"},
    "objects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["category", "objectKey", "title", "content", "evidenceTexts", "confidence"],
        "properties": {
          "category": {"enum": ["basic", "education", "internship", "work", "project", "skill", "award", "certificate", "preference", "constraint"]},
          "objectKey": {"type": "string", "minLength": 1, "maxLength": 100},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "content": {"type": "string", "minLength": 1, "maxLength": 10000},
          "evidenceTexts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {"type": "string", "minLength": 1, "maxLength": 2000}
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

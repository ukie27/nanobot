      "dimension": "reviews",
      "weight": 1,
      "evaluator": "exact",
      "threshold": 100,
      "critical": true,
      "inputFiles": ["reviews/bundles.json"],
      "expected": {"file": "reviews/expected_resolutions.json", "pointer": "/staleVersion"}
    },
    {

      "dimension": "jobs",
      "weight": 1,
      "evaluator": "exact",
      "threshold": 100,
      "critical": true,
      "inputFiles": ["jobs/hard_gate_failed.md"],
      "expected": {"file": "jobs/expected_requirements.json", "pointer": "/hardGateFailed/expectedFit"}
    },
    {

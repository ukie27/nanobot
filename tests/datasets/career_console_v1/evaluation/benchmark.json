{
  "schemaVersion": "career-console.evaluation.v1",
  "benchmark": "career_console_product_v1.0",
  "dataset": "career_console_v1",
  "timezone": "Asia/Shanghai",
  "baseTime": "2026-07-28T09:00:00+08:00",
  "passCriteria": {
    "minimumOverallScore": 85,
    "criticalCasesMustPass": true
  },
  "dimensions": [
    {"id": "profile", "name": "职业档案与证据", "weight": 10},
    {"id": "opportunities", "name": "招聘机会获取", "weight": 8},
    {"id": "jobs", "name": "岗位理解与匹配", "weight": 10},
    {"id": "materials", "name": "简历与材料", "weight": 10},
    {"id": "applications", "name": "申请档案与状态", "weight": 12},
    {"id": "mail", "name": "邮件智能与任务", "weight": 15},
    {"id": "reviews", "name": "确认与正式写入边界", "weight": 10},
    {"id": "interviews", "name": "面试准备与复盘", "weight": 8},
    {"id": "connectors", "name": "连接器与会话", "weight": 7},
    {"id": "safety", "name": "安全、隐私与抗注入", "weight": 10}
  ],

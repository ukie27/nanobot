    {
      "id": "mail.read_and_unread",
      "dimension": "mail",
      "weight": 1,
      "evaluator": "exact",
      "threshold": 100,
      "critical": true,
      "inputFiles": ["mail/application_confirmation.eml"],
      "expected": {"file": "mail/expected_intelligence.json", "pointer": "/includeReadAndUnread"}
    },
    {
      "id": "mail.timezone",
      "dimension": "mail",
      "weight": 1,
      "evaluator": "exact",
      "threshold": 100,
      "critical": true,
      "inputFiles": ["mail/timezone_mail.eml"],
      "expected": {"file": "mail/expected_intelligence.json", "pointer": "/timezone"}

      "inputFiles": ["profile/resume_backend.md", "profile/project_notes.md"],
      "expected": {"file": "profile/expected_extraction.json", "pointer": "/expectedSections"}
    },
    {
      "id": "profile.conflict_requires_confirmation",
      "dimension": "profile",
      "weight": 1,
      "evaluator": "exact",
      "threshold": 100,
      "critical": true,
      "inputFiles": ["profile/conflicting_resume.md"],
      "expected": {"file": "profile/expected_extraction.json", "pointer": "/conflicts/0/requiresUserConfirmation"}
    },
    {
      "id": "opportunities.today_items",
      "dimension": "opportunities",
      "weight": 1,
      "evaluator": "subset",
      "threshold": 100,
      "critical": false,
      "inputFiles": ["opportunities/nowcoder_today.json"],
      "expected": {"file": "opportunities/nowcoder_today.json", "pointer": "/items"}
